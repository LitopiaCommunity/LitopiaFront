{
  "name": "litopia-front",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "dev:ssr": "ng serve --proxy-config proxy.conf.json",
    "build:ssr": "ng build",
    "serve:ssr": "node dist/LitopiaFront/server/server.mjs",
    "prebuild": "gulp compress",
    "openAPIGenerator": "openapi-generator-cli generate -i http://localhost:8000/api-json -g typescript-angular -o ./src/app/apis/litopia-api",
    "pm2:stop": "pm2 stop litopia-front",
    "pm2:start": "pm2 start dist/LitopiaFront/server/server.mjs --name litopia-front"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.3.18",
    "@angular/cdk": "^20.2.14",
    "@angular/common": "^20.3.18",
    "@angular/compiler": "^20.3.18",
    "@angular/core": "^20.3.18",
    "@angular/forms": "^20.3.18",
    "@angular/material": "^20.2.14",
    "@angular/platform-browser": "^20.3.18",
    "@angular/platform-browser-dynamic": "^20.3.18",
    "@angular/platform-server": "^20.3.18",
    "@angular/router": "^20.3.18",
    "@angular/ssr": "^20.3.22",
    "compression": "^1.7.4",
    "express": "^4.18.2",
    "marked": "^16.4.2",
    "ngx-markdown": "^20.1.0",
    "rxjs": "~7.5.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.3.22",
    "@angular/cli": "^20.3.22",
    "@angular/compiler-cli": "^20.3.18",
    "@types/compression": "^1.7.2",
    "@types/express": "^4.17.17",
    "@types/jasmine": "~4.0.0",
    "@types/node": "^20.19.39",
    "browser-sync": "^3.0.0",
    "gulp": "^4.0.2",
    "gulp-sharp-responsive": "^0.4.0",
    "jasmine-core": "~4.2.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.0.0",
    "typescript": "~5.8.3"
  }
}
