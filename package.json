{
  "name": "litopia-front",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "dev:ssr": "ng serve --proxy-config proxy.conf.json",
    "build:ssr": "ng build",
    "serve:ssr": "node dist/LitopiaFront/server/server.mjs",
    "prebuild": "gulp compress",
    "openAPIGenerator": "openapi-generator-cli generate -i http://localhost:8000/api-json -g typescript-angular -o ./src/app/apis/litopia-api",
    "pm2:stop": "pm2 stop litopia-front",
    "pm2:start": "pm2 start dist/LitopiaFront/server/server.mjs --name litopia-front"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^19.2.20",
    "@angular/cdk": "^19.2.19",
    "@angular/common": "^19.2.20",
    "@angular/compiler": "^19.2.20",
    "@angular/core": "^19.2.20",
    "@angular/forms": "^19.2.20",
    "@angular/material": "^19.2.19",
    "@angular/platform-browser": "^19.2.20",
    "@angular/platform-browser-dynamic": "^19.2.20",
    "@angular/platform-server": "^19.2.20",
    "@angular/router": "^19.2.20",
    "@angular/ssr": "^19.2.23",
    "compression": "^1.7.4",
    "express": "^4.18.2",
    "marked": "^15.0.12",
    "ngx-markdown": "^19.1.1",
    "rxjs": "~7.5.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.23",
    "@angular/cli": "~19.2.23",
    "@angular/compiler-cli": "^19.2.20",
    "@types/compression": "^1.7.2",
    "@types/express": "^4.17.17",
    "@types/jasmine": "~4.0.0",
    "@types/node": "^18.19.130",
    "browser-sync": "^3.0.0",
    "gulp": "^4.0.2",
    "gulp-sharp-responsive": "^0.4.0",
    "jasmine-core": "~4.2.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.0.0",
    "typescript": "~5.8.3"
  }
}
